{
  "manifest_version": 3,
  "name": "download-tool",
  "version": "1.0.0",
  "description": "查看和管理 Chrome 下载；删除时同时移除磁盘文件与下载记录。",
  "minimum_chrome_version": "123",
  "permissions": [
    "downloads",
    "downloads.open"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "download-tool",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
